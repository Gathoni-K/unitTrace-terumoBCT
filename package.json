{
  "name": "data-quality-workbench",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @workbench/web",
    "build": "npm run build --workspaces",
    "lint": "eslint . --ignore-pattern '**/*.ts' --ignore-pattern '**/*.tsx'",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:types": "supabase gen types typescript --local > packages/shared/src/db.types.ts",
    "ingest": "tsx --env-file=.env scripts/ingest.ts",
    "detect": "tsx --env-file=.env scripts/detect.ts",
    "server": "tsx --env-file=.env scripts/server.ts",
    "export:clean": "tsx --env-file=.env scripts/export-clean.ts",
    "metrics:before-after": "tsx --env-file=.env scripts/metrics/before-after.ts",
    "measure:baseline": "tsx --env-file=.env scripts/measure-baseline.ts",
    "export:fhir": "tsx --env-file=.env scripts/export-fhir.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
